<script>
  function showNextStep(groupId) {
    const steps = document.querySelectorAll(`[data-step-group="${groupId}"]`);
    for (let i = 0; i < steps.length; i++) {
      if (!steps[i].classList.contains("show")) {
        steps[i].classList.add("show");
        break;
      }
    }
  }

  function resetSteps(groupId) {
    const steps = document.querySelectorAll(`[data-step-group="${groupId}"]`);
    steps.forEach(step => step.classList.remove("show"));
  }

  function clearActivityInputs() {
    const inputs = document.querySelectorAll(".fill-blank");
    inputs.forEach(input => input.value = "");
  }
</script>

